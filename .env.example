# ── MongoDB (stesso URI della taxi app) ───────────────────────────────────────
MONGO_URI=mongodb://utente:password@host:27017/nomedb

# Nomi collection condivise con la taxi app (modifica se diversi)
MONGO_USERS_COLLECTION=users
MONGO_CLIENTI_COLLECTION=clienti

# ── Auth (stesso secret della taxi app) ───────────────────────────────────────
JWT_SECRET=inserisci-qui-lo-stesso-secret-della-taxi-app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Certificato ADE (mutual TLS) ──────────────────────────────────────────────
FATTURE_CERT_PATH=./fatture-connector/certs/certificato.p12
FATTURE_CERT_PASSWORD=password-certificato

# ── Scheduler (cron expression) ───────────────────────────────────────────────
# default: ogni ora   →  0 * * * *
# ogni notte a 02:00  →  0 2 * * *
SYNC_CRON=0 * * * *

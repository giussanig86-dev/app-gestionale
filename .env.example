# ── MongoDB (stesso DB della taxi app) ───────────────────────────────────────
# DB name: calcolatore-forfettario
MONGO_URI=mongodb://utente:password@host:27017/calcolatore-forfettario

# Override nome collection utenti (default: users)
MONGO_USERS_COLLECTION=users

# ── Auth (stesso secret della taxi app) ───────────────────────────────────────
JWT_SECRET=inserisci-qui-lo-stesso-secret-della-taxi-app

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Certificato ADE (mutual TLS) ──────────────────────────────────────────────
FATTURE_CERT_PATH=./fatture-connector/certs/certificato.p12
FATTURE_CERT_PASSWORD=password-certificato

# ── Scheduler ─────────────────────────────────────────────────────────────────
# ogni ora: 0 * * * *  |  ogni notte alle 02:00: 0 2 * * *
SYNC_CRON=0 * * * *

# ── A-Cube API (invio fatture attive e corrispettivi verso SDI) ────────────────
# Sandbox: https://app.sandbox.acubeapi.com  |  Prod: https://app.acubeapi.com
ACUBE_BASE_URL=https://app.sandbox.acubeapi.com
ACUBE_EMAIL=email@dominio.it
ACUBE_PASSWORD=password-acube
# Segreto HMAC per verificare i webhook in arrivo da A-Cube (opzionale ma consigliato)
ACUBE_WEBHOOK_SECRET=secret-webhook-acube
